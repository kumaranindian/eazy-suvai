{
  "name": "eazysuvai-functions",
  "private": true,
  "description": "EazySuvai Cloud Functions (2nd gen, asia-south1).",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:emulators": "npm run build && firebase emulators:exec --project demo-eazysuvai --only auth,firestore,functions,storage --config ../firebase.json \"jest -c jest.emulator.config.js && node scripts/check-storage-urls.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "libphonenumber-js": "^1.13.16",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
