exports[`state pages (FR-099) coming-soon matches its snapshot and is valid HTML 1`] = `
"<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Spice &lt;Garden&gt; – Menu coming soon</title>
<style>:root{--es-background:#FFF8EE;--es-surface:#FFFFFF;--es-text:#2B2B2B;--es-muted-text:#5C5C5C;--es-accent:#A8550A;--es-border:#E8DCCB}*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--es-background);color:var(--es-text);font-family:var(--es-font),system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5}
a{color:var(--es-accent)}:focus-visible{outline:3px solid var(--es-accent);outline-offset:2px}
.wrap{max-width:1200px;margin:0 auto;padding-inline:16px}
h1{margin:0;font-size:1.6rem;line-height:1.2;color:var(--es-text)}
main{min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:32px 16px}
.card{max-width:480px}
.mark{width:56px;height:56px;margin:0 auto 16px;border-radius:16px;background:var(--es-accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700}
.name{margin:0 0 8px;color:var(--es-muted-text);font-weight:600}
p{margin:12px 0 0;color:var(--es-muted-text)}
.btn{display:inline-flex;align-items:center;min-height:48px;padding:0 24px;margin-top:20px;border-radius:999px;background:var(--es-accent);color:#fff;text-decoration:none;font-weight:600}
footer{position:fixed;bottom:12px;left:0;right:0;text-align:center;font-size:.85rem;color:var(--es-muted-text)}</style>
</head>
<body class="state state-coming-soon">
<main>
<div class="card">
<div class="mark" aria-hidden="true">e</div>
<p class="name">Spice &lt;Garden&gt;</p>
<h1>Menu coming soon</h1>
<p>Spice &lt;Garden&gt; is getting its menu ready. Please check back soon.</p>

</div>
</main>
<footer>EazySuvai</footer>
</body>
</html>"
`;

