rules_version = '2';

// EazySuvai Firestore rules.
//
// Everything is denied unless a match below allows it. Each module opens only
// the paths it needs, following docs/architecture.md §5, and adds a test for
// every collection in firestore-tests/.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Shared helpers ---------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // FR-091: nothing is readable with an unverified email.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // FR-084: platform admins must have signed in with a TOTP second factor.
    function isAdmin() {
      return verified()
        && request.auth.token.role == 'platformAdmin'
        && request.auth.token.firebase.sign_in_second_factor == 'totp';
    }

    // Owner of `rid` (claims set by completeRegistration, M01) whose
    // restaurant is active (FR-099, FR-010).
    function isOwner(rid) {
      return verified()
        && request.auth.token.role == 'owner'
        && request.auth.token.restaurantId == rid
        && get(/databases/$(database)/documents/restaurants/$(rid)).data.status == 'active';
    }

    // ---- M01: accounts ----------------------------------------------------

    // Written only by Functions (completeRegistration, admin bootstrap).
    match /users/{uid} {
      allow get: if (verified() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Tenant root. Created by completeRegistration (M01). Owners update the
    // draft profile fields below directly (M03, architecture §5); everything
    // else (status, planId, slug, qrCode, counts, publishedVersion,
    // pricesNeedReview, nameLower, owner fields, country, subscription) is
    // written only by Functions.
    match /restaurants/{rid} {
      allow get: if isOwner(rid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isOwner(rid) && (validOwnerUpdate() || qrDownloadCounted());
      allow create, delete: if false;
    }

    // M13 (FRD §13): the owner app counts a QR download: exactly +1, alone.
    function qrDownloadCounted() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qrDownloads'])
        && request.resource.data.qrDownloads == resource.data.get('qrDownloads', 0) + 1;
    }

    // ---- M03: restaurant profile (FR-011 to FR-013, FR-103) --------------
    //
    // Budget: rules stop evaluating a request after a fixed amount of work
    // (measured on the emulator: a week of 21 opening-hour slots as maps,
    // checked field by field, did not fit next to the other fields). So
    // opening hours, contact details and social links are each checked with
    // ONE regex over their joined values, and a value of the wrong type
    // makes `matches()` / `keys()` / `size()` / `+` fail, which denies the
    // request without an explicit `is` check. "The heaviest update" in
    // restaurant-profile.test.js writes every field at once; keep it green
    // when adding checks (M05: theme).

    function validOwnerUpdate() {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      // Profile and theme fields: the draft (FR-012). Changing any of them
      // must stamp draftUpdatedAt with the server time. setupCompletedAt:
      // the first-run wizard was finished or skipped.
      let draft = ['name', 'businessType', 'description', 'logo', 'cover', 'contact',
                   'openingHours', 'visibility', 'currency', 'timezone', 'themeId',
                   'themeSettings'];
      return changed.hasOnly(draft.concat(['draftUpdatedAt', 'setupCompletedAt']))
        && (!changed.hasAny(draft.concat(['draftUpdatedAt']))
            || next.draftUpdatedAt == request.time)
        && (!('setupCompletedAt' in changed) || next.setupCompletedAt == request.time)
        && (!('name' in changed) || validName(next.name))
        && (!('businessType' in changed) || validBusinessType(next.businessType))
        && (!('description' in changed) || next.description.size() <= 500 && next.description is string)
        // Image objects are written only by processImage (M02); owners may
        // only remove an image.
        && (!('logo' in changed) || next.logo == null)
        && (!('cover' in changed) || next.cover == null)
        && (!('contact' in changed) || validContact(next.contact))
        && (!('openingHours' in changed) || next.openingHours == null || validHours(next.openingHours))
        && (!('visibility' in changed) || validVisibility(next.visibility))
        && (!('currency' in changed) || next.currency.matches('^[A-Z]{3}$'))
        && (!('timezone' in changed) || validTimezone(next.timezone))
        // M05 (FR-055, FR-058): a theme that exists, and overrides as one
        // regex over "primary|secondary|background|font|layout|cardLayout|mode"
        // (each part empty or valid). Fonts are checked against
        // config/platform.fonts in the app; M07 falls back for unknown ones.
        // M10 (BR-011): a premium theme needs planFeatures.premiumThemes
        // (copied from the plan by Functions; missing = Free = no).
        && (!('themeId' in changed) || next.themeId == null
            || next.themeId.matches('^[A-Za-z0-9_-]{1,64}$')
               && exists(/databases/$(database)/documents/themes/$(next.themeId))
               && (get(/databases/$(database)/documents/themes/$(next.themeId)).data.get('premium', false) != true
                   || resource.data.get('planFeatures', {}).get('premiumThemes', false) == true))
        && (!('themeSettings' in changed) || next.themeSettings == null
            || validThemeSettings(next.themeSettings));
    }

    function validThemeSettings(s) {
      let hex = '(#[0-9A-F]{6})?';
      return s.keys().hasOnly(['primary', 'secondary', 'background', 'font', 'layout', 'cardLayout', 'mode'])
        && (s.get('primary', '') + '|' + s.get('secondary', '') + '|' + s.get('background', '') + '|'
            + s.get('font', '') + '|' + s.get('layout', '') + '|' + s.get('cardLayout', '') + '|'
            + s.get('mode', ''))
           .matches('^' + hex + '[|]' + hex + '[|]' + hex + '[|]([A-Za-z][A-Za-z ]{0,39})?'
             + '[|](list|grid)?[|](compact|image-top|image-left)?[|](light|dark)?$');
    }

    function validName(v) {
      return v.size() <= 80 && v.trim().size() > 0 && v is string;
    }

    // Keep in sync with BUSINESS_TYPES (functions) and BusinessType (core).
    function validBusinessType(v) {
      return v in ['restaurant', 'cafe', 'bakery', 'cloudKitchen', 'sweetShop',
                   'juiceBar', 'foodTruck', 'bar', 'hotel', 'other'];
    }

    // contact: {phone (E.164), email, address, city, postalCode, website
    // (https), social {instagram, facebook, x, youtube, googleMaps} (https)}.
    // Empty values are left out. The apps also check the phone number and
    // postal code against the country.
    //
    // One regex over "phone|email|postalCode|website", each part empty or
    // valid, and one over the five social links joined the same way. No
    // part can contain '|', so a value cannot spill into its neighbour.
    function validContact(c) {
      let url = '(https://[^\\s|/?#]+[.][^\\s|/?#]+([/?#][^\\s|]*)?)?';
      let joined = c.get('phone', '') + '|' + c.get('email', '') + '|'
        + c.get('postalCode', '') + '|' + c.get('website', '');
      let s = c.get('social', {});
      let links = s.get('instagram', '') + '|' + s.get('facebook', '') + '|'
        + s.get('x', '') + '|' + s.get('youtube', '') + '|' + s.get('googleMaps', '');
      return c.keys().hasOnly(['phone', 'email', 'address', 'city', 'postalCode', 'website', 'social'])
        && c.get('email', '').size() <= 254
        && c.get('website', '').size() <= 300
        && c.get('address', '').size() <= 200 && c.get('address', '') is string
        && c.get('city', '').size() <= 60 && c.get('city', '') is string
        && joined.matches('^([+][1-9][0-9]{6,14})?'
            + '[|]([^@\\s|]+@[^@\\s|]+[.][^@\\s|]+)?'
            + '[|]([A-Za-z0-9][A-Za-z0-9 -]{1,11})?'
            + '[|]' + url + '$')
        && s.keys().hasOnly(['instagram', 'facebook', 'x', 'youtube', 'googleMaps'])
        && links.size() <= 1500
        && links.matches('^' + url + '[|]' + url + '[|]' + url + '[|]' + url + '[|]' + url + '$');
    }

    // FR-013: which contact details the public menu shows.
    function validVisibility(v) {
      return v.keys().hasOnly(['phone', 'email', 'address', 'hours', 'social'])
        && (!('phone' in v) || v.phone is bool)
        && (!('email' in v) || v.email is bool)
        && (!('address' in v) || v.address is bool)
        && (!('hours' in v) || v.hours is bool)
        && (!('social' in v) || v.social is bool);
    }

    // FR-011: per weekday up to 3 slots "HH:mm-HH:mm" joined with ',', or
    // "" for closed: {mon: "07:00-11:00,18:00-23:30", tue: "", ...}. Times
    // are in the restaurant's time zone; a close earlier than the open runs
    // past midnight, and "24:00" is not used ("00:00" as a close means
    // midnight). Order and overlaps are checked in the apps.
    //
    // One string per day so the whole week is checked with ONE regex; a
    // list of slot maps did not fit the rules budget (see above).
    function validHours(h) {
      let t = '([01][0-9]|2[0-3]):[0-5][0-9]';
      let day = '(' + t + '-' + t + '(,' + t + '-' + t + '){0,2})?';
      let week = h.get('mon', '') + ';' + h.get('tue', '') + ';' + h.get('wed', '') + ';'
        + h.get('thu', '') + ';' + h.get('fri', '') + ';' + h.get('sat', '') + ';' + h.get('sun', '');
      return h.keys().hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
        && week.size() <= 300
        && week.matches('^' + day + ';' + day + ';' + day + ';' + day + ';' + day + ';' + day + ';' + day + '$');
    }

    // IANA name such as Asia/Kolkata or America/Argentina/Buenos_Aires.
    function validTimezone(v) {
      return v.size() <= 64 && v.matches('^(UTC|[A-Z][A-Za-z]+(/[A-Za-z0-9_+-]+){1,2})$');
    }

    // ---- M04: menu content (FR-015 to FR-033, FR-095, FR-098) -----------
    //
    // Categories and items are draft content. Create and (soft) delete go
    // through the callables (plan limits in a transaction, BR-011); owners
    // update only the fields below, and every update stamps updatedAt with
    // the server time. Soft-deleted documents can't be edited (restore them
    // with restoreDeleted). Image objects are written only by processImage
    // (M02); owners may only remove one. Field limits match MENU_LIMITS
    // (functions/src/menu/schemas.ts) and MenuLimits (core).

    match /restaurants/{rid}/categories/{cid} {
      allow read: if isOwner(rid) || isAdmin();
      allow update: if isOwner(rid) && validCategoryUpdate();
      allow create, delete: if false;
    }

    match /restaurants/{rid}/items/{iid} {
      allow read: if isOwner(rid) || isAdmin();
      allow update: if isOwner(rid) && validItemUpdate();
      allow create, delete: if false;
    }

    function editableMenuDoc(allowed) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get('deletedAt', null) == null
        && changed.hasOnly(allowed)
        && request.resource.data.updatedAt == request.time;
    }

    function validCategoryUpdate() {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      return editableMenuDoc(['name', 'description', 'image', 'sequence', 'active', 'updatedAt'])
        && (!('name' in changed) || validMenuName(next.name, 60))
        && (!('description' in changed) || next.description is string && next.description.size() <= 250)
        && (!('image' in changed) || next.image == null)
        && (!('sequence' in changed) || validSequence(next.sequence))
        && (!('active' in changed) || next.active is bool);
    }

    function validItemUpdate() {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      return editableMenuDoc(['name', 'description', 'image', 'priceMinor', 'dietaryLabelId',
                              'tagIds', 'featured', 'sequence', 'available', 'updatedAt'])
        && (!('name' in changed) || validMenuName(next.name, 80))
        && (!('description' in changed) || next.description is string && next.description.size() <= 500)
        && (!('image' in changed) || next.image == null)
        // BR-019: integer minor units, never a float.
        && (!('priceMinor' in changed)
            || next.priceMinor is int && next.priceMinor >= 0 && next.priceMinor <= 999999999)
        // FR-023: exactly one platform-managed label. A retired label stays
        // valid on items that have it (FR-104); the apps hide it from new
        // choices. Unknown tag ids are dropped when publishing (M06).
        && (!('dietaryLabelId' in changed)
            || next.dietaryLabelId is string
               && exists(/databases/$(database)/documents/dietaryLabels/$(next.dietaryLabelId)))
        && (!('tagIds' in changed) || next.tagIds is list && next.tagIds.size() <= 10)
        && (!('featured' in changed) || next.featured is bool)
        && (!('sequence' in changed) || validSequence(next.sequence))
        && (!('available' in changed) || next.available is bool);
    }

    function validMenuName(v, max) {
      return v is string && v.size() <= max && v.trim().size() > 0;
    }

    function validSequence(v) {
      return v is int && v >= 0 && v <= 1000000000000;
    }

    // ---- M06: published versions (FR-062, FR-096) -------------------------
    //
    // Immutable snapshots written only by publishMenu / rollbackMenu. Owners
    // and admins read them (version history). The draft kept for discard and
    // rollback (versions/{n}/private/source) and live/availability stay
    // Functions-only; the public menu (M07) reads with the Admin SDK. The
    // root fields publishedVersion, publishedAt, publishedDraftAt,
    // publishedCurrency and versionHistory are outside the owner whitelist.
    match /restaurants/{rid}/versions/{n} {
      allow read: if isOwner(rid) || isAdmin();
      allow write: if false;
    }

    // ---- M09: analytics (FR-072, BR-005) -----------------------------------
    //
    // Daily aggregates are written only by collectEvent (Admin SDK). The
    // owner of an active restaurant and TOTP admins read them. Raw events
    // (analyticsEvents) and stats/platform stay closed (default deny).
    match /restaurants/{rid}/analyticsDaily/{day} {
      allow read: if isOwner(rid) || isAdmin();
      allow write: if false;
    }

    // Platform-managed dietary labels and item tags (FR-023, FR-033,
    // FR-104): read by owners and admins, written by Functions (M11).
    match /dietaryLabels/{id} {
      allow read: if (verified() && request.auth.token.role == 'owner') || isAdmin();
      allow write: if false;
    }

    match /itemTags/{id} {
      allow read: if (verified() && request.auth.token.role == 'owner') || isAdmin();
      allow write: if false;
    }

    // ---- M05: themes and fonts (FR-056, FR-059) ---------------------------
    //
    // Predefined themes and the platform config (font list, currencies) are
    // read by owners and admins and written by Functions (seed script, M11).
    // Which themes a plan allows is enforced by M10.
    match /themes/{id} {
      allow read: if (verified() && request.auth.token.role == 'owner') || isAdmin();
      allow write: if false;
    }

    // ---- M10: plans (FR-076, FR-078) --------------------------------------
    //
    // Plan names, limits and prices are shown to owners (plan comparison).
    // Written by Functions (seed, M11). upgradeRequests, payments,
    // subscriptionHistory and mail stay closed (callables only).
    match /plans/{planId} {
      allow read: if (verified() && request.auth.token.role == 'owner') || isAdmin();
      allow write: if false;
    }

    match /config/platform {
      allow get: if (verified() && request.auth.token.role == 'owner') || isAdmin();
      allow write: if false;
    }

    // ---- Default: deny ----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
