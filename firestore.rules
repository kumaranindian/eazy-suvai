rules_version = '2';

// EazySuvai Firestore rules.
//
// M00 baseline: deny everything. Each module opens only the paths it needs,
// following the tenant pattern in docs/architecture.md §5, and adds a test
// for every new collection in firestore-tests/.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
